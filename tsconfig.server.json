{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "src/server/**/*.ts",
    "src/types.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "server-dist"
  ]
}